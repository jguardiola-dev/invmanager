@startuml Arquitectura_InvManager
skinparam backgroundColor white
skinparam shadowing false
skinparam rectangle {
  BackgroundColor #F5F5F5
  BorderColor #555555
  FontSize 14
}
skinparam arrow {
  Color #333333
  FontSize 12
}

title Arquitectura en capas — InvManager

rectangle "**Capa de Presentación**\n\nPaquete: ui\n\nVentanas Swing:\nMain, VentanaPrincipal,\nFormularioProducto,\nVentanaCategorias,\nVentanaProveedores,\nProductoTableModel" as UI #E3F2FD

rectangle "**Capa de Lógica**\n\nPaquetes: service + util\n\nProductoService\nAppConfig\nCSVExporter" as LOGICA #FFF9C4

rectangle "**Capa de Datos**\n\nPaquete: dao + model\n\nDatabaseConnection\nProductoDAO\nCategoriaDAO\nProveedorDAO\nProducto, Categoria, Proveedor" as DATOS #C8E6C9

database "inventario.db\n(SQLite)" as DB #A5D6A7

UI --> LOGICA
LOGICA --> DATOS
DATOS --> DB

@enduml